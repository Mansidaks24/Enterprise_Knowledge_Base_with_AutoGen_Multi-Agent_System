# Enterprise Knowledge Base .env Template
# Copy this file to .env and fill in your values

# LLM Provider (choose one)
# For OpenAI:
OPENAI_API_KEY=sk-your_key_here
# For Azure OpenAI (optional alternative):
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=deployment-name

# Databases & Storage
DATABASE_URL=sqlite:///./knowledge_base.db
REDIS_URL=redis://localhost:6379

# Vector DB Configuration
# Options: 'faiss' (local, free), 'chroma' (local persistence), 'pinecone' (hosted)
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/faiss_index

# Logging
LOG_LEVEL=INFO

# AutoGen / Orchestration (for future use)
AUTOGEN_CONFIG_PATH=./groupchat_config.json
